{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kangae.local/app_definition_v1.schema.json",
  "title": "Kangae AppDefinition v1 (design proposal)",
  "description": "Declarative composition only. Runtime bindings, secrets, executable code, and absolute layout coordinates are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "purpose", "sources", "capabilities", "datasets", "view", "workflows"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 90 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" }, "maxItems": 16 },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "maxItems": 100 },
    "datasets": { "type": "array", "items": { "$ref": "#/$defs/dataset" }, "maxItems": 60 },
    "view": { "$ref": "#/$defs/view" },
    "workflows": { "type": "array", "items": { "$ref": "#/$defs/workflow" }, "maxItems": 24 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,79}$" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": { "enum": ["api", "cua", "trusted_adapter"] }
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_id", "name", "kind", "requires_confirmation", "verify_as"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": { "enum": ["read", "write", "execute"] },
        "requires_confirmation": { "type": "boolean" },
        "verify_as": { "enum": ["read_back", "state_compare", "human_review", "unavailable"] }
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "produced_by", "record_key"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "produced_by": { "$ref": "#/$defs/id" },
        "record_key": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "kind", "label", "importance"],
      "properties": {
        "key": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["heading", "text", "status", "list", "data_table", "detail", "form", "select", "button", "run_progress", "calendar", "timeline", "diff_view", "media_controls", "workflow_graph", "workflow_launcher"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 140 },
        "importance": { "enum": ["primary", "secondary", "supporting"] },
        "dataset_id": { "$ref": "#/$defs/id" },
        "action_id": { "$ref": "#/$defs/id" },
        "workflow_id": { "$ref": "#/$defs/id" },
        "visible_in": { "type": "array", "uniqueItems": true, "minItems": 1, "items": { "enum": ["idle", "selected", "editing", "running", "needs_approval", "failed", "unverified", "completed"] } }
      }
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "role", "components"],
      "properties": {
        "key": { "$ref": "#/$defs/id" },
        "role": { "enum": ["toolbar", "primary", "context", "activity"] },
        "components": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/component" } }
      }
    },
    "view": {
      "type": "object", "additionalProperties": false,
      "required": ["pattern", "regions"],
      "properties": {
        "pattern": { "enum": ["list_detail", "form_result", "timeline", "monitor", "comparison", "media_workspace", "canvas"] },
        "regions": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/region" } }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "capability_id", "after"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "capability_id": { "$ref": "#/$defs/id" },
        "after": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/step" } }
      }
    }
  }
}
