{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kangae.local/workspace_plan_v1.schema.json",
  "title": "Kangae WorkspacePlan v1 - composition and permission intent only",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "goal", "spaces", "sources", "views", "policies"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "workspace_id": {"type": "string", "minLength": 2},
    "goal": {"type": "string", "minLength": 1},
    "spaces": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "default_private"],
        "properties": {
          "id": {"type": "string", "minLength": 2},
          "label": {"type": "string", "minLength": 1},
          "default_private": {"type": "boolean"}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "provider", "space_id", "access", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 2},
          "provider": {"type": "string", "minLength": 1},
          "space_id": {"type": "string", "minLength": 2},
          "access": {"enum": ["read_only", "draft_only", "write_after_review", "candidate"]},
          "status": {"enum": ["candidate", "requires_auth", "verified_read", "verified_write", "screen_only", "blocked"]}
        }
      }
    },
    "views": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "space_id", "kind", "context_pane"],
        "properties": {
          "id": {"type": "string", "minLength": 2},
          "space_id": {"type": "string", "minLength": 2},
          "kind": {"enum": ["unified_inbox", "project_context", "sales_outreach", "source_ui_handoff"]},
          "context_pane": {"type": "boolean"}
        }
      }
    },
    "policies": {
      "type": "object", "additionalProperties": false,
      "required": ["cross_space_retrieval", "send_mode", "retention_decision", "android_connector"],
      "properties": {
        "cross_space_retrieval": {"const": "deny_by_default"},
        "send_mode": {"enum": ["draft_only", "review_each_send", "permitted_rule_based_auto"]},
        "retention_decision": {"enum": ["not_selected", "user_configured"]},
        "android_connector": {"enum": ["unresolved_clippy", "scrcpy_candidate", "none", "approved_adapter"]}
      }
    }
  }
}
