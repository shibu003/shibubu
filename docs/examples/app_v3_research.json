{
  "schema_version": "3.0",
  "id": "example.research",
  "version": 1,
  "title": "Research Desk",
  "goal": {
    "literal_goal": "研究ノートを作りたい",
    "outcomes": [
      "研究ノートを作りたい"
    ],
    "assumptions": [
      "このプレビューで外部アカウントには接続しない"
    ],
    "constraints": [
      "ユーザーの承認なく外部データにアクセスしない"
    ]
  },
  "composition": {
    "root": {
      "key": "research-root",
      "component": "split",
      "props": {},
      "children": [
        {
          "key": "research-list",
          "component": "list",
          "props": {},
          "binding": {
            "source_ref": "local.notes",
            "path": "notes"
          }
        },
        {
          "key": "research-content",
          "component": "column",
          "props": {},
          "children": [
            {
              "key": "research-editor",
              "component": "editor",
              "props": {},
              "binding": {
                "source_ref": "local.notes",
                "path": "selected.body"
              }
            },
            {
              "key": "research-save",
              "component": "button",
              "props": {
                "label": "保存"
              },
              "action_ref": "local.notes.save"
            }
          ]
        }
      ]
    },
    "view_modes": [
      "use",
      "build",
      "review"
    ]
  },
  "actions": [
    {
      "id": "local.notes.save",
      "effect": "local_write",
      "readiness": "preview_only",
      "input_schema": {
        "type": "object"
      },
      "required_scopes": [],
      "requires_approval": false
    }
  ],
  "sources": [
    {
      "id": "local.notes",
      "kind": "local_collection",
      "readiness": "local"
    }
  ],
  "agent": {
    "suggestions_enabled": true,
    "autonomy_level": "suggest_only",
    "entrypoint": "agent_rail"
  },
  "state": {
    "readiness": "preview",
    "execution_mode": "local_demo",
    "status_message": "設計サンプル。実データは接続しない。"
  }
}
